msgctxt "#32000"
msgid "Squeezelite"
msgstr "Squeezelite"

msgctxt "#32001"
msgid "Do not auto start squeezelite"
msgstr "Ne pas démarrer Squeezelite automatiquement"

msgctxt "#32002"
msgid "Manual path to squeezelite executable"
msgstr "Chemin manuel vers l'exécutable Squeezelite"

msgctxt "#32003"
msgid "On Android en IOS, squeezelite is not supported"
msgstr "Sur Android et iOS, Squeezelite n'est pas pris en charge"

msgctxt "#32004"
msgid "Install a Squeezeplayer app from the appstore"
msgstr "Installez une application Squeezeplayer depuis le magasin d'applications"

msgctxt "#32005"
msgid "For Android, a good choice is SB Player"
msgstr "Sur Android, SB Player est un bon choix"

msgctxt "#32006"
msgid "On iOS, the iPeng app is a good choice"
msgstr "Sur iOS, l'application iPeng est un bon choix"

msgctxt "#32007"
msgid "By default, this addon will try to start squeezelite in the background for you"
msgstr "Par défaut, cet addon démarre Squeezelite en arrière-plan pour vous"

msgctxt "#32008"
msgid "You can override this behaviour if you already have squeezelite running in the background"
msgstr "Vous pouvez désactiver ce comportement si Squeezelite tourne déjà en arrière-plan"

msgctxt "#32009"
msgid "It is also possible to provide your own path to the squeezelite binary"
msgstr "Il est également possible de spécifier votre propre chemin vers l'exécutable Squeezelite"

msgctxt "#32010"
msgid "Specify MAC-address of player manually"
msgstr "Spécifier l'adresse MAC du lecteur manuellement"

msgctxt "#32011"
msgid "Define MAC-address (lowercase only!)"
msgstr "Définir l'adresse MAC (minuscules uniquement !)"

msgctxt "#32100"
msgid "LMS Server"
msgstr "Serveur LMS"

msgctxt "#32101"
msgid "Do not autodiscover LMS server"
msgstr "Ne pas détecter le serveur LMS automatiquement"

msgctxt "#32102"
msgid "LMS server hostname"
msgstr "Nom d'hôte du serveur LMS"

msgctxt "#32103"
msgid "LMS server web port"
msgstr "Port web du serveur LMS"



msgctxt "#32201"
msgid "Play album"
msgstr "Lire l'album"

msgctxt "#32202"
msgid "Browse album"
msgstr "Parcourir l'album"

msgctxt "#32203"
msgid "Play now"
msgstr "Lire maintenant"

msgctxt "#32204"
msgid "Play next"
msgstr "Lire ensuite"

msgctxt "#32205"
msgid "Add to current playlist"
msgstr "Ajouter à la liste de lecture actuelle"

msgctxt "#32206"
msgid "Synchronize"
msgstr "Synchroniser"

msgctxt "#32207"
msgid "Synchronize all players to this player"
msgstr "Synchroniser tous les lecteurs avec celui-ci"

msgctxt "#32208"
msgid "Un-sync all players"
msgstr "Désynchroniser tous les lecteurs"

msgctxt "#32209"
msgid "Select output audio device"
msgstr "Sélectionner le périphérique de sortie audio"


